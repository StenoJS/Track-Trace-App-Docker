# Kopieer naar .env voor lokaal draaien (npm start). Bij Portainer horen deze
# als stack-omgevingsvariabelen ingevuld te worden, niet in een los bestand.

GMAIL_USER=jouw.adres@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
TELEGRAM_BOT_TOKEN=123456789:AA...
# Komma-gescheiden, geen spaties nodig: 111111111,222222222
TELEGRAM_CHAT_IDS=111111111
POLL_INTERVAL_MINUTES=10
# Optioneel: eigen postcode (zonder spatie) voor een direct werkende PostNL
# track&trace-link. Zonder deze var krijg je nog wel een link, alleen moet
# je de postcode er dan zelf nog even bij invullen op hun site.
POSTNL_POSTCODE=7556HN
